{
  "name": "radman-labs",
  "version": "2.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "test:db": "node tests/sql-policy.mjs",
    "format": "prettier --write src tests *.ts *.mjs *.json",
    "diagnose:auth": "node --env-file-if-exists=.env.local scripts/diagnose-auth.mjs"
  },
  "dependencies": {
    "@radix-ui/react-slot": "1.2.3",
    "@supabase/ssr": "0.7.0",
    "@supabase/supabase-js": "2.57.4",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "0.468.0",
    "motion": "12.23.24",
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sharp": "^0.35.5",
    "tailwind-merge": "3.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.3.14",
    "@playwright/test": "1.56.1",
    "@tailwindcss/postcss": "4.1.18",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "prettier": "3.6.2",
    "tailwindcss": "4.1.18",
    "tsx": "4.20.6",
    "typescript": "^5"
  },
  "overrides": {
    "typescript-eslint": "8.72.1",
    "baseline-browser-mapping": "2.11.38",
    "@typescript-eslint/typescript-estree": {
      "minimatch": "11.0.1"
    }
  },
  "engines": {
    "node": "22.x"
  }
