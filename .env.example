NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Optional server-only GitHub token for higher API quota. Public repositories work without it.
GITHUB_TOKEN=
# Legacy projects may use NEXT_PUBLIC_SUPABASE_ANON_KEY instead of the publishable key.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# GitHub metadata cache: 30–3600 seconds.
GITHUB_RELEASE_CACHE_SECONDS=300
# Local-only, explicitly labeled development preview; ignored on Vercel production.
CATALOG_PREVIEW=false
